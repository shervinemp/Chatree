# Chatree Configuration
# Local SQLite database path (created automatically)
CHATREE_DB_PATH=./data/chatree.db

# Default models (LiteLLM format or mock/chatree-demo for zero-key testing)
# Examples:
#   mock/chatree-demo
#   openrouter/anthropic/claude-sonnet-4
#   openrouter/google/gemini-2.5-pro
#   gemini/gemini-2.5-flash
#   anthropic/claude-sonnet-4-20250514
#   openai/gpt-4o
#   ollama/llama3.2
CHATREE_DEFAULT_MODEL=mock/chatree-demo
CHATREE_SHADOW_MODEL=inherit
CHATREE_SUMMARY_MODEL=inherit

# Optional custom OpenAI-compatible API base URL
# CHATREE_API_BASE=http://localhost:11434/v1

# IPC Guardrail Defaults
CHATREE_MAX_HOP_DEPTH=3
CHATREE_TOKEN_BUDGET=96000
CHATREE_AUTO_COMMIT_HANDOFFS=false

# Provider API Keys (set whichever provider(s) you use)
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
