# Chatree Configuration
# Local SQLite database path (created automatically)
CHATREE_DB_PATH=./data/chatree.db

# LLM backend driver: auto (litellm if installed, else zero-dep openai_compat), litellm, openai_compat, or mock
CHATREE_LLM_PROVIDER=auto

# Default models (any LiteLLM or OpenAI-compatible provider prefix, or mock/chatree-demo for zero-key testing)
# Examples:
#   mock/chatree-demo
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-pro
#   deepseek/deepseek-chat
#   openrouter/anthropic/claude-sonnet-4
#   groq/llama-3.3-70b-versatile
#   ollama/llama3.2
#   vllm/Qwen/Qwen2.5-72B-Instruct
CHATREE_DEFAULT_MODEL=mock/chatree-demo
CHATREE_SHADOW_MODEL=inherit
CHATREE_SUMMARY_MODEL=inherit

# Optional OpenAI-compatible API base URL & key override (Ollama, vLLM, SGLang, LM Studio, custom proxies)
# CHATREE_API_BASE=http://localhost:11434/v1
# CHATREE_API_KEY=

# IPC Guardrail Defaults
CHATREE_MAX_HOP_DEPTH=3
CHATREE_TOKEN_BUDGET=96000
CHATREE_AUTO_COMMIT_HANDOFFS=false

# Provider API Keys (set whichever provider(s) you use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHERAI_API_KEY=
# XAI_API_KEY=
